{
  "name": "@pacific-code-labs/fire-code-design-system",
  "version": "0.1.1",
  "type": "module",
  "description": "FireCode CR shared design system — Blue Book token contract + runtime theme engine (override > org > default). Consumed by fire-code-fe and the future admin app.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
